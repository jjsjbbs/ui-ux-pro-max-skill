# ── Anthropic Claude ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model to use (default: claude-sonnet-4-6)
# Options: claude-opus-4-7, claude-sonnet-4-6, claude-haiku-4-5-20251001
CLAUDE_MODEL=claude-sonnet-4-6

# ── Twilio (WhatsApp) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Clinic Configuration ─────────────────────────────────────────────────────
# Path to clinic.json (relative to project root or absolute)
CLINIC_CONFIG_PATH=config/clinic.json

# ── Redis (optional — for multi-instance session persistence) ────────────────
# Leave empty to use in-memory sessions (single server)
REDIS_URL=redis://localhost:6379

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# Webhook base URL (used to display webhook URL in startup logs)
WEBHOOK_BASE_URL=https://your-domain.com
